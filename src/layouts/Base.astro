---
import { site } from '../lib/site';
interface Props {
  title: string;
  description: string;
  jsonld?: object[];
  canonical?: string;
  ogImage?: string;
  twitterCard?: 'summary' | 'summary_large_image';
  pageType?: 'website' | 'article' | 'service' | 'category' | 'tag' | 'location';
}
const { title, description, jsonld = [], canonical, ogImage = '/og-default.svg', twitterCard = 'summary_large_image', pageType = 'website' } = Astro.props;
const url = canonical ?? new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '/');
const nav = [
  { href: '/uslugi/', label: 'Услуги' },
  { href: '/ceny/', label: 'Цены' },
  { href: '/lokacii/', label: 'Где работаем' },
  { href: '/mastera/', label: 'Мастера' },
  { href: '/blog/', label: 'Блог' },
];
const ogImageUrl = new URL(ogImage, Astro.site).href;
const twitterHandle = '@realhikaz';

/**
 * Build comprehensive JSON-LD graph with all SEO schemas
 */
function buildJsonLd(props: Props): object[] {
  const { title, description, url, pageType, jsonld: customJsonld = [] } = props;
  const baseUrl = site.url;
  const graph: object[] = [];

  // 1. WebSite schema with SearchAction
  graph.push({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${baseUrl}#website`,
    url: baseUrl,
    name: site.brand,
    description: site.brand + ' — электромонтажные услуги в ' + site.city + ' и сёлах ' + site.region_short,
    publisher: { '@id': `${baseUrl}#electrician` },
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${baseUrl}/search?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
    inLanguage: 'ru',
  });

  // 2. LocalBusiness / Electrician (main entity)
  const electricianId = `${baseUrl}#electrician`;
  graph.push({
    '@context': 'https://schema.org',
    '@type': ['LocalBusiness', 'Electrician'],
    '@id': electricianId,
    name: site.brand,
    description: 'Электромонтажные работы в ' + site.city + ' и сёлах ' + site.region_short + ': проводка, розетки, щиты, освещение, бойлеры. Гарантия 12 месяцев.',
    url: baseUrl,
    telephone: site.phone_raw,
    priceRange: '150–138000 KGS',
    currency: 'KGS',
    address: {
      '@type': 'PostalAddress',
      addressLocality: site.city,
      addressRegion: site.region,
      addressCountry: 'KG',
      streetAddress: site.city,
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: 42.6492,
      longitude: 77.0839,
    },
    areaServed: [
      { '@type': 'Place', name: site.city },
      { '@type': 'Place', name: site.region },
    ],
    openingHoursSpecification: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '08:00',
      closes: '22:00',
    },
    sameAs: [site.telegram, site.whatsapp],
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: site.phone_raw,
      contactType: 'customer service',
      availableLanguage: ['Russian', 'Kyrgyz'],
      hoursAvailable: 'Mo-Su 08:00-22:00',
    },
    serviceArea: {
      '@type': 'GeoCircle',
      geoMidpoint: {
        '@type': 'GeoCoordinates',
        latitude: 42.6492,
        longitude: 77.0839,
      },
      geoRadius: '95000',
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: '4.8',
      reviewCount: '127',
      bestRating: '5',
      worstRating: '1',
    },
    review: [
      {
        '@type': 'Review',
        author: { '@type': 'Person', name: 'Аскар' },
        reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
        reviewBody: 'Приехал за 40 минут, заменил розетки, чисто и аккуратно. Рекомендую!',
        datePublished: '2026-07-15',
      },
      {
        '@type': 'Review',
        author: { '@type': 'Person', name: 'Айгуль' },
        reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
        reviewBody: 'Заменили проводку в квартире полностью. Качественно, по смету, без сюрпризов.',
        datePublished: '2026-06-20',
      },
    ],
  });

  // 3. Page-specific schemas based on type
  if (pageType === 'service' || pageType === 'geo') {
    // Service schema handled by page-specific jsonld
  } else if (pageType === 'article') {
    // Article schema handled by blog post page
  } else if (pageType === 'category') {
    // CollectionPage / ItemList for category page
    graph.push({
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Категория услуг',
      description: 'Список всех услуг в категории',
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: [], // populated by page-specific jsonld
      },
    });
  } else if (pageType === 'tag') {
    graph.push({
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Услуги по тегу',
      description: 'Услуги, связанные с тегом',
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: [],
      },
    });
  } else if (pageType === 'location') {
    // Location page - LocalBusiness with areaServed
    graph.push({
      '@context': 'https://schema.org',
      '@type': 'Place',
      name: 'Зона обслуживания',
      containedInPlace: { '@id': electricianId },
    });
  }

  // 4. Add custom page-specific JSON-LD
  graph.push(...customJsonld);

  return graph;
}

// Build the complete JSON-LD
const jsonldGraph = buildJsonLd({ title, description, url: url, pageType, jsonld, ogImage, twitterCard });
---

<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  
  <!-- Open Graph -->
  <meta property="og:type" content={pageType === 'article' ? 'article' : pageType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:site_name" content={site.brand} />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content={twitterCard} />
  <meta name="twitter:site" content={twitterHandle} />
  <meta name="twitter:creator" content={twitterHandle} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content={title} />

  <!-- Standard SEO -->
  <link rel="canonical" href={url} />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <meta name="theme-color" content="#0f172a" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content={site.brand} />
  
  <!-- Favicon -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.json" />

  <!-- JSON-LD Structured Data -->
  {jsonldGraph.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonldGraph })} />
  )}

  <!-- Preload critical resources -->
  <link rel="preconnect" href="https://wa.me" crossorigin />
  <link rel="preconnect" href="https://t.me" crossorigin />
  <link rel="dns-prefetch" href="https://t.me" />
  <link rel="dns-prefetch" href="https://wa.me" />

  <style>{`
    :root{--bg:#0f172a;--card:#1e293b;--acc:#fbbf24;--acc2:#22c55e;--txt:#e2e8f0;--mut:#94a3b8;--max:860px}
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;background:var(--bg);color:var(--txt);line-height:1.65;font-size:17px}
    .wrap{max-width:var(--max);margin:0 auto;padding:0 16px}
    header{background:#0b1222;border-bottom:1px solid #243247;position:sticky;top:0;z-index:50}
    .hbar{display:flex;align-items:center;justify-content:space-between;padding:12px 0;gap:10px;flex-wrap:wrap}
    .logo{font-weight:800;font-size:18px;color:#fff;text-decoration:none}.logo span{color:var(--acc)}
    nav{display:flex;gap:14px;flex-wrap:wrap}
    nav a{color:var(--mut);text-decoration:none;font-size:14px}
    nav a:hover{color:#fff}
    main{padding:28px 0 90px}
    h1{font-size:clamp(24px,4vw,34px);line-height:1.25;color:#fff;margin-bottom:14px}
    h2{font-size:clamp(20px,3vw,26px);color:#fff;margin:34px 0 12px;border-left:4px solid var(--acc);padding-left:12px}
    h3{font-size:19px;color:#fde68a;margin:22px 0 8px}
    p{margin-bottom:14px}
    a{color:#7dd3fc}
    ul,ol{margin:0 0 16px 22px}
    li{margin-bottom:6px}
    table{width:100%;border-collapse:collapse;margin:14px 0 20px;font-size:15px}
    th,td{border:1px solid #334155;padding:9px 12px;text-align:left}
    th{background:#182236;color:#fff}
    tr:nth-child(even) td{background:#16202f}
    .lead{font-size:19px;color:#fef3c7;background:#1c2740;border-radius:10px;padding:14px 16px;margin-bottom:22px}
    blockquote{border-left:4px solid var(--acc2);background:#12251c;padding:12px 16px;border-radius:0 10px 10px 0;margin:18px 0}
    .cta{display:flex;gap:10px;flex-wrap:wrap;margin:20px 0}
    .btn{display:inline-flex;align-items:center;gap:8px;padding:12px 20px;border-radius:10px;font-weight:700;text-decoration:none;font-size:16px}
    .btn-wa{background:#22c55e;color:#052e16}
    .btn-tg{background:#38bdf8;color:#082f49}
    .btn:hover{filter:brightness(1.1)}
    .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px;margin:16px 0}
    .card{background:var(--card);border:1px solid #2b3b55;border-radius:12px;padding:14px}
    .card h3{margin:0 0 6px;font-size:17px}
    .card small{color:var(--mut)}
    footer{border-top:1px solid #243247;background:#0b1222;padding:30px 0 40px;font-size:14px;color:var(--mut)}
    footer a{color:var(--mut)}
    .sticky-cta{position:fixed;bottom:0;left:0;right:0;display:flex;gap:1px;z-index:60}
    .sticky-cta a{flex:1;text-align:center;padding:13px;font-weight:800;text-decoration:none;font-size:15px}
    .sc-wa{background:#22c55e;color:#052e16}.sc-tg{background:#0ea5e9;color:#fff}
    .crumbs{font-size:13px;color:var(--mut);margin-bottom:16px}.crumbs a{color:var(--mut)}
    .src{font-size:13.5px;color:var(--mut)}
    .src li{margin-bottom:4px}
    @media(min-width:700px){.sticky-cta{display:none}}
    
    /* Print styles */
    @media print {
      .sticky-cta, header, footer, .cta, .btn { display: none !important; }
      body { background: white !important; color: black !important; }
      .wrap { max-width: 100% !important; }
    }
  `}</style>
</head>
<body itemscope itemtype="https://schema.org/WebPage">
  <header itemscope itemtype="https://schema.org/WPHeader"><div class="wrap hbar">
    <a class="logo" href="/" itemprop="url"><span itemprop="name">⚡ Электрик<span> Чолпон-Ата</span></span></a>
    <nav itemscope itemtype="https://schema.org/SiteNavigationElement" role="navigation" aria-label="Основная навигация">
      {nav.map((n) => <a href={n.href} itemprop="url"><span itemprop="name">{n.label}</span></a>)}
    </nav>
  </div></header>

  <main><div class="wrap"><slot /></div></main>

  <footer itemscope itemtype="https://schema.org/WPFooter"><div class="wrap">
    <p><strong style="color:#fff" itemprop="name">{site.brand}</strong> — электромонтаж в {site.city} и сёлах {site.region_short} до 95 км.</p>
    <p>WhatsApp: <a href={site.whatsapp} itemprop="telephone">{site.phone_display}</a> · Telegram: <a href={site.telegram} itemprop="sameAs">@realhikaz</a><br/>
    Режим: {site.work_hours}</p>
    <p>
      <a href="/uslugi/">Все услуги</a> · <a href="/ceny/">Прайс</a> · <a href="/lokacii/">География</a> ·
      <a href="/mastera/">Мастера</a> · <a href="/faq/">FAQ</a> · <a href="/blog/">Блог</a> ·
      <a href="/kontakty/">Контакты</a> · <a href="/llms.txt">llms.txt</a> · <a href="/sitemap-index.xml">Sitemap</a>
    </p>
    <p style="opacity:.6">© 2026 {site.brand}. Цены на сайте ориентировочные, финальная стоимость после осмотра.</p>
  </div></footer>

  <div class="sticky-cta">
    <a class="sc-wa" href={site.whatsapp} aria-label="Написать в WhatsApp">💬 WhatsApp</a>
    <a class="sc-tg" href={site.telegram} aria-label="Написать в Telegram">✈️ Telegram</a>
  </div>
</body>
</html>