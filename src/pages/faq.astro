---
import Base from '../layouts/Base.astro';
import Cta from '../components/CtaButtons.astro';
import Faq from '../components/FaqBlock.astro';
import { getCollection } from 'astro:content';
import { breadcrumbsLd, faqLd, electricianLd, webPageLd, webSiteLd } from '../lib/jsonld';
import { site } from '../lib/site';

const services = await getCollection('services');
const picked = ['zamena-rozetki', 'zamena-provodki-dome', 'ustanovka-lyustry', 'sborka-elektroshchita', 'podklyuchenie-boylera', 'srochnyy-vyzov-elektrika'];
const faq = [
  { q: 'Как вызвать электрика в Чолпон-Ате?', a: 'Напишите в WhatsApp с фото проблемы — ответим за 5 минут с ценой и временем приезда. По городу приезжаем за 30–60 минут.' },
  ...picked.map((slug) => {
    const s = services.find((x) => x.data.slug === slug);
    return s?.data.faq?.[0] ?? { q: slug, a: '' };
  }).filter((f) => f.a),
  { q: 'Работаете ли вы в сёлах?', a: 'Да, 32 населённых пункта в радиусе до 95 км: Бостери, Тамчы, Корумду, Ананьево, Григорьевка, Ак-Суу, Балыкчы и другие. Надбавка 200–1000 сом.' },
  { q: 'Есть ли гарантия?', a: '12 месяцев письменно на все монтажные работы. Материалы — по гарантии производителя.' },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const pageJsonLd = [
  webSiteLd(),
  faqJsonLd,
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${site.url}/faq/#webpage`,
    name: 'FAQ — вопросы об услугах электрика',
    description: 'Ответы на частые вопросы: как вызвать электрика, цены, гарантия, выезд в сёла Иссык-Куля, аварийные работы 24/7.',
    url: `${site.url}/faq/`,
    isPartOf: { '@id': `${site.url}#website` },
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: site.url },
        { '@type': 'ListItem', position: 2, name: 'FAQ' },
      ],
    },
    inLanguage: 'ru-RU',
  },
];
---
<Base title="FAQ — вопросы об услугах электрика на Иссык-Куле" description="Ответы на частые вопросы: как вызвать электрика, цены, гарантия, выезд в сёла Иссык-Куля, аварийные работы 24/7." jsonld={pageJsonLd}>
  <nav class="crumbs"><a href="/">Главная</a> → FAQ</nav>
  <h1>Частые вопросы об услугах электрика</h1>
  <p class="lead">Кратко о ценах, гарантиях и выезде. Не нашли свой вопрос — напишите в WhatsApp, отвечаем быстро.</p>
  <Faq faq={faq} title="Все вопросы" />
  <Cta />
</Base>