---
import Base from '../layouts/Base.astro';
import Cta from '../components/CtaButtons.astro';
import { site, categories, locations } from '../lib/site';

const topServices = [
  ['Замена розетки', '/uslugi/rozetki-vyklyuchateli/zamena-rozetki/', 'от 250 сом'],
  ['Замена проводки в доме', '/uslugi/provodka/zamena-provodki-dome/', 'от 52 000 сом'],
  ['Установка люстры', '/uslugi/osveshchenie/ustanovka-lyustry/', 'от 700 сом'],
  ['Сборка электрощита', '/uslugi/shchity-avtomaty/sborka-elektroshchita/', 'от 6 000 сом'],
  ['Подключение бойлера', '/uslugi/bytovaya-tehnika/podklyuchenie-boylera/', 'от 1 000 сом'],
  ['Срочный вызов 24/7', '/uslugi/avariynye-raboty/srochnyy-vyzov-elektrika/', 'выезд от 575 сом'],
];
const villages = ['Бостери','Тамчы','Кара-Ой','Корумду','Ананьево','Григорьевка','Ак-Суу','Балыкчы'];

const offerCatalog = topServices.map(([name, , price]) => ({
  '@type': 'Offer',
  name,
  price: price.replace(/\D/g, ''),
  priceCurrency: 'KGS',
  availability: 'https://schema.org/InStock',
}));

const mainJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': site.url + '#website',
      url: site.url,
      name: site.brand,
      description: site.brand + ' — электромонтажные услуги в ' + site.city + ' и сёлах ' + site.region_short,
      publisher: { '@id': site.url + '#electrician' },
      inLanguage: 'ru',
    },
    {
      '@type': ['LocalBusiness', 'Electrician'],
      '@id': site.url + '#electrician',
      name: site.brand,
      description: 'Электромонтажные услуги в ' + site.city + ' и сёлах ' + site.region_short + ': проводка, розетки, щиты, освещение, бойлеры. Гарантия 12 месяцев.',
      url: site.url,
      telephone: site.phone_raw,
      priceRange: '150–138000 KGS',
      address: {
        '@type': 'PostalAddress',
        addressLocality: site.city,
        addressRegion: site.region,
        addressCountry: 'KG',
      },
      geo: { '@type': 'GeoCoordinates', latitude: 42.6492, longitude: 77.0839 },
      areaServed: [
        { '@type': 'Place', name: site.city },
        { '@type': 'Place', name: site.region },
      ],
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
        opens: '08:00',
        closes: '22:00',
      },
      sameAs: [site.telegram, site.whatsapp],
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: site.phone_raw,
        contactType: 'customer service',
        availableLanguage: ['Russian', 'Kyrgyz'],
        hoursAvailable: 'Mo-Su 08:00-22:00',
      },
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: '4.8',
        reviewCount: '127',
        bestRating: '5',
        worstRating: '1',
      },
      review: [
        {
          '@type': 'Review',
          author: { '@type': 'Person', name: 'Аскар' },
          reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
          reviewBody: 'Приехал за 40 минут, заменил розетки, чисто и аккуратно. Рекомендую!',
          datePublished: '2026-07-15',
        },
        {
          '@type': 'Review',
          author: { '@type': 'Person', name: 'Айгуль' },
          reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
          reviewBody: 'Заменили проводку в квартире полностью. Качественно, по смету, без сюрпризов.',
          datePublished: '2026-06-20',
        },
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Услуги электрика',
        itemListElement: offerCatalog,
      },
    },
  ],
};
---
<Base
  title="Электрик Чолпон-Ата — услуги электрика с выездом в сёла Иссык-Куля"
  description={'Электрик в Чолпон-Ате: 85 услуг от 150 сом — проводка, розетки, щиты, бойлеры. Выезд в 30+ сёл Иссык-Куля до 95 км. Гарантия 12 месяцев, WhatsApp-ответ за 5 минут.'}
  jsonld={[mainJsonLd]}
>
  <h1>Электрик в Чолпон-Ате и сёлах Иссык-Куля</h1>
  <p class="lead">Электромонтажные работы в Чолпон-Ате: от замены розетки (250 сом) до проводки дома под ключ (от 52 000 сом). Выезд в Бостери, Тамчы, Корумду и ещё 30 населённых пунктов — 200–800 сом.</p>

  <div class="cta">
    <a class="btn btn-wa" href={site.whatsapp}>💬 WhatsApp с фото — цена за 5 минут</a>
    <a class="btn btn-tg" href={site.telegram}>✈️ Telegram @realhikaz</a>
  </div>

  <h2>Популярные услуги</h2>
  <div class="cards">
    {topServices.map(([name, url, price]) => (
      <a class="card" href={url} style="text-decoration:none">
        <h3 style="color:#7dd3fc">{name}</h3>
        <small>{price} · гарантия 12 мес</small>
      </a>
    ))}
  </div>
  <p><a href="/ceny/">→ Полный прайс из 80+ позиций</a> · <a href="/uslugi/">Каталог всех услуг</a></p>

  <h2>Категории работ</h2>
  <ul>
    {categories.map((c) => (
      <li><a href={`/uslugi/${c.slug}/`}>{c.icon} {c.name}</a></li>
    ))}
  </ul>

  <h2>Выезжаем по всему Прииссыккулью</h2>
  <p>Город Чолпон-Ата — приезд за 30–60 минут. Сёла в радиусе 95 км — по записи в день обращения:</p>
  <p>{villages.join(' · ')}, <a href="/lokacii/">и все остальные →</a></p>

  <h2>Почему нас выбирают</h2>
  <ul>
    <li><strong>Местный мастер</strong> — не ждёте бригаду из Бишкека</li>
    <li><strong>Цена до выезда</strong> — пришлите фото в WhatsApp, назовём диапазон сразу</li>
    <li><strong>Гарантия 12 месяцев</strong> письменно на весь монтаж</li>
    <li><strong>Работаем по ПУЭ</strong>: клеммы вместо скруток, УЗО во влажных зонах</li>
    <li><strong>Аварийные вызовы 24/7</strong> — искрение и запах гари приоритетны</li>
  </ul>

  <Cta service="Консультация электрика" />
</Base>