---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site } from '../../lib/site';
import { collectionPageLd, itemListLd } from '../../lib/jsonld';

const posts = (await getCollection('blog'))
  .filter((p) => !/status:\s*"?todo/.test(p.body ?? ''))
  .sort((a, b) => (b.data.date ?? '').localeCompare(a.data.date ?? ''));

// Build ItemList for blog posts
const blogItems = posts.map((p, i) => ({
  '@type': 'ListItem',
  position: i + 1,
  item: {
    '@type': 'BlogPosting',
    '@id': `${site.url}/blog/${p.id}#article`,
    headline: p.data.title,
    description: p.data.description,
    datePublished: p.data.date ?? '',
    url: `${site.url}/blog/${p.id}/`,
    author: { '@type': 'Person', name: site.founder },
  },
}));

const blogJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Блог об электрике',
  description: 'Статьи об электрике на Иссык-Куле: реальные цены, выбор мастера, защита от скачков напряжения.',
  url: `${site.url}/blog/`,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: blogItems,
  },
};
---
<Base title="Блог об электрике — Иссык-Куль: цены, советы, безопасность" description="Статьи об электрике на Иссык-Куле: реальные цены 2026, выбор мастера, защита от скачков напряжения, подготовка пансионатов к сезону." jsonld={[
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Блог об электрике',
    description: 'Статьи об электрике на Иссык-Куле: реальные цены 2026, выбор мастера, защита от скачков напряжения, подготовка пансионатов к сезону.',
    url: `${site.url}/blog/`,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: blogItems,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Блог', item: `${site.url}/blog/` },
    ],
  },
]}>
  <nav class="crumbs"><a href="/">Главная</a> → Блог</nav>
  <h1>Блог об электрике на Иссык-Куле</h1>
  <p class="lead">Практические материалы от мастеров: сколько стоят работы в {new Date().getFullYear()} году, как не переплатить и что делать при аварии.</p>
  <div class="cards">
    {posts.map((p) => (
      <a class="card" href={`/blog/${p.id}/`} style="text-decoration:none">
        <h3 style="color:#7dd3fc">{p.data.title}</h3>
        <small>{p.data.date} · {p.data.keyword}</small>
      </a>
    ))}
  </div>
</Base>