---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Cta from '../../components/CtaButtons.astro';
import { render, getCollection } from 'astro:content';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const tags = await getCollection('tags');
  return tags.map((entry) => ({ params: { tag: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const services = (await getCollection('services')).filter(s => s.data.tags.includes(d.slug));

const itemListItems = services.map((s, i) => ({
  '@type': 'ListItem',
  position: i + 1,
  item: {
    '@type': 'Service',
    '@id': site.url + '/uslugi/' + s.data.category + '/' + s.data.slug + '/#service',
    name: s.data.name,
    description: s.data.description,
    url: site.url + '/uslugi/' + s.data.category + '/' + s.data.slug + '/',
    offers: {
      '@type': 'Offer',
      priceCurrency: 'KGS',
      priceSpecification: {
        '@type': 'PriceSpecification',
        minPrice: s.data.price_min,
        maxPrice: s.data.price_max,
        priceCurrency: 'KGS',
      },
    },
    areaServed: { '@type': 'Place', name: 'Чолпон-Ата и сёла Иссык-Куля' },
    provider: { '@id': site.url + '#electrician' },
  },
}));

const tagJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: d.name,
      description: d.description,
      url: site.url + '/tagi/' + d.slug + '/',
      mainEntity: { '@type': 'ItemList', itemListElement: itemListItems },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: site.url },
        { '@type': 'ListItem', position: 2, name: 'Услуги', item: site.url + '/uslugi/' },
        { '@type': 'ListItem', position: 3, name: d.h1 },
      ],
    },
  ],
};
---
<Base title={d.title} description={d.description} pageType="tag" jsonld={[tagJsonLd]}>
  <Breadcrumbs items={[{ name: 'Главная', url: '/' }, { name: 'Услуги', url: '/uslugi/' }, { name: d.h1 }]} />
  <h1>{d.h1}</h1>
  <article><Content /></article>

  <h2>Услуги по тегу «{d.name}»</h2>
  <ul>
    {services.map(s => (
      <li><a href={`/uslugi/${s.data.category}/${s.data.slug}/`}>{s.data.name}</a> — от {s.data.price_min} сом</li>
    ))}
  </ul>

  <Cta service={d.title} />
</Base>