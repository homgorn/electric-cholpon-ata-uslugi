---
// Только отображение FAQ. FAQPage JSON-LD добавляется ОДИН раз через jsonld-проп страницы.
interface Props { faq: { q: string; a: string }[]; title?: string }
const { faq, title = 'Частые вопросы' } = Astro.props;
---
<h2>{title}</h2>
{faq.map((f) => (
  <div>
    <h3>{f.q}</h3>
    <p>{f.a}</p>
  </div>
))}