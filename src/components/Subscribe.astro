---
import { site } from '../lib/site';
---

<section style="background:#12251c;border:1px solid #2b3b55;border-radius:14px;padding:24px;margin:28px 0">
  <h2 style="font-size:18px;margin:0 0 8px;color:#fbbf24">✉️ Получать обновления цен и новых услуг</h2>
  <p style="font-size:14px;margin-bottom:14px;color:#94a3b8">Подпишитесь на обновления: сезонные ТО, новые цены и советы по электрике на Иссык-Куле.</p>
  <form action="#" method="POST" onsubmit="this.innerHTML='<b style=\'color:#22c55e\'>✓ Подписка оформлена</b>'; event.preventDefault();" style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
    <label for="email-in" style="font-size:13px;color:#e2e8f0;display:flex;flex-direction:column;flex:1;min-width:220px">Email:
      <input id="email-in" type="email" required style="margin-top:4px;padding:8px;border-radius:8px;background:#0f172a;color:#fff;border:1px solid #334155;font-size:15px" placeholder="your@email.com" />
    </label>
    <button type="submit" style="padding:10px 16px;border-radius:8px;background:#fbbf24;color:#0f172a;font-weight:700;font-size:14px;border:none;cursor:pointer;white-space:nowrap;margin-top:20px">Подписаться</button>
  </form>
  <p style="font-size:12px;color:#64748b;margin-top:8px">Никакого спама — только полезные материалы. Отписка в любой момент.</p>
</section>

<!-- Email capture event tracking (add this snippet in page using Subscribe component) -->
<script is:inline>
  document.querySelector('form[action="#"]')?.addEventListener('submit', () => {
    if (window.gtag) gtag('event', 'subscribe_email', { page: window.location.pathname, source: 'subscribe_block' });
    if (window.ym) window.ym(ВАШ_НОМЕР_МЕТРИКИ, 'reachGoal', 'subscribe_email');
  });
</script>
